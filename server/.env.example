# ──────────────────────────────────────────────────────────────
# Analytics Server - Environment Variables Template
# Copy this file to .env and fill in the values for your setup.
# ──────────────────────────────────────────────────────────────

# Database (MySQL)
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://ems_app_user:secure_app_password_change_me@localhost:3308/cms_dev

# Server
PORT=4001
NODE_ENV=development           # development | production

# JWT
# Generate a secure secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=generate_a_secure_64_char_secret_here
JWT_EXPIRES_IN=24h

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Docker MySQL (if using docker-compose)
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_APP_PASSWORD=secure_app_password_change_me

# Business Configuration (optional – falls back to defaults in constants.js)
DEFAULT_CURRENCY=INR           # Currency code for revenue tracking (ISO 4217)

# Rate Limiting (optional overrides)
# RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in ms
# RATE_LIMIT_MAX_REQUESTS=200  # Requests per window per IP (standard endpoints)
# RATE_LIMIT_MAX_EXPENSIVE=30  # Requests per window per IP (date-range endpoints)
