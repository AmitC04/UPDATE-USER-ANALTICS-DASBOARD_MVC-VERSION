# ──────────────────────────────────────────────────────────────
# Analytics Server - Environment Variables Template (Issue #19)
# Copy this file to .env and fill in the values for your setup.
# ──────────────────────────────────────────────────────────────

# Database (MySQL)
# Format: mysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql://ems_app_user:secure_app_password_change_me@localhost:3308/cms_dev

# Server
PORT=4001
NODE_ENV=development           # development | production

# JWT
# Generate a secure secret: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=generate_a_secure_64_char_secret_here
JWT_EXPIRES_IN=24h

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000

# Docker MySQL (if using docker-compose)
MYSQL_ROOT_PASSWORD=root_password_change_me
MYSQL_APP_PASSWORD=secure_app_password_change_me
